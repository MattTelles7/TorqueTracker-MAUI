<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="tellescm_MD_Final.Views.VehiclesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:tellescm_MD_Final.Models"
    xmlns:viewModels="clr-namespace:tellescm_MD_Final.ViewModels"
    x:DataType="viewModels:VehiclesViewModel"
    x:Name="Root"
    Title="Vehicles">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">

                <Label
        Style="{StaticResource PageTitle}"
        Text="Vehicles"
        SemanticProperties.HeadingLevel="Level1"/>

                <Label
        Text="Active vehicles saved on this device."/>

                <Label
        FontAttributes="Bold"
        Text="{Binding VehicleCount,
               StringFormat='Active Vehicles: {0}'}"/>

                <Picker
        Title="Sort By"
        ItemsSource="{Binding SortOptions}"
        SelectedItem="{Binding SelectedSortOption}" />

            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Command="{Binding AddVehicleCommand}"
                    SemanticProperties.Hint="Opens the add vehicle form"
                    Text="Add vehicle"
                    VerticalOptions="Center" />
        </Grid>

        <Label Grid.Row="1"
               IsVisible="{Binding HasError}"
               SemanticProperties.Description="Loading error"
               Style="{StaticResource StatusMessage}"
               Text="{Binding ErrorMessage}" />

        <RefreshView Grid.Row="2"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Vehicles}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20,48" Spacing="8">
                        <Label FontAttributes="Bold"
                               FontSize="18"
                               HorizontalTextAlignment="Center"
                               Text="No vehicles yet" />
                        <Label HorizontalTextAlignment="Center"
                               Text="Use Add vehicle to create your first vehicle profile." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Vehicle">
                        <Border Margin="0,0,0,12" Padding="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="5">
                                    <Label FontAttributes="Bold"
                       FontSize="18"
                       Text="{Binding Nickname}" />
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{Binding Year}" />
                                        <Label Text="{Binding Make}" />
                                        <Label Text="{Binding Model}" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding CurrentMileage, StringFormat='Current mileage: {0:N0} miles'}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.ArchiveVehicleCommand}"
                    CommandParameter="{Binding .}"
                    SemanticProperties.Hint="Archives this vehicle so it no longer appears in the list"
                    Text="Archive"
                    VerticalOptions="Start" />
                            </Grid>
                        </Border>
                    </DataTemplate>

                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
