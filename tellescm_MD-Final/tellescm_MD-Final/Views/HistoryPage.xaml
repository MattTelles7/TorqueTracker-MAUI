<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="tellescm_MD_Final.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="History">

    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Style="{StaticResource PageTitle}"
               Text="Maintenance history"
               SemanticProperties.HeadingLevel="Level1" />
        <Border Padding="18">
            <VerticalStackLayout Spacing="8">
                <Label FontAttributes="Bold" Text="Planned for the next stage" />
                <Label Text="Service logging and maintenance history are not implemented in this checkpoint." />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>
